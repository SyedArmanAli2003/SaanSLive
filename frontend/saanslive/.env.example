# Public browser configuration. The Supabase anon key is designed for browser
# use; access must remain protected by Supabase RLS policies.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Server-only credentials. Set these in Vercel/GitHub/local .env.local only.
# Never prefix these names with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
AGENT_RUN_TOKEN=use-a-long-random-token
NVIDIA_NIM_API_KEY=your-nvidia-nim-api-key
NVIDIA_NIM_MODEL=your-nvidia-nim-model
